{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kodigo",
  "version": "0.1.1",
  "identifier": "com.kodigo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kodigo",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Gerald Digamon",
    "category": "Productivity",
    "shortDescription": "A local-first Markdown notes app",
    "longDescription": "Kodigo turns any folder of Markdown files into a searchable notebook: a file tree, a tabbed editor with live Markdown styling and code-block tooling, full-text search, and tags. Your notes stay plain .md files on disk.",
    "copyright": "Copyright (c) 2026 Gerald Digamon",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
